OPSPILOT_ENVIRONMENT=development
# 设置后，Incident 和 Audit 使用关系型存储；示例仅用于本地 Compose。
OPSPILOT_DATABASE_URL=postgresql+psycopg://opspilot:opspilot@localhost:5432/opspilot
# 设置后，应用启动时会加载 kubeconfig 并创建只读调查依赖。
OPSPILOT_PROMETHEUS_URL=http://127.0.0.1:9090
# 审批接口只信任服务端令牌映射出的操作员身份；生产值必须来自 Secret。
OPSPILOT_OPERATOR_ID=local-operator
OPSPILOT_OPERATOR_TOKEN=replace-with-a-long-random-secret
# Alertmanager 使用独立 Secret，不能与操作员令牌复用。
OPSPILOT_ALERTMANAGER_TOKEN=replace-with-a-different-random-secret
